---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';
---
<BaseLayout
  title="Layer — Skincare Routine App"
  description="Layer is an upcoming iOS app for skincare—organize your shelf, build your AM/PM routine, track what works, and discover your next product. A Timberline Ventures product, coming soon."
  path="/layer"
>
  <slot name="head" slot="head">
    <BreadcrumbSchema crumbs={[{ name: 'Layer', path: '/layer' }]} />
  </slot>

  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Coming Soon · Consumer Apps</span>
      <h1>Layer — your <em>skincare</em> shelf</h1>
      <p class="hero-sub">
        A native iOS app for skincare: organize the products on your shelf, build and layer your AM/PM routine, track what is actually working for your skin, and discover what to add next. Built and operated by Timberline Ventures LLC.
      </p>
      <div class="cta-row">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href="/#portfolio" class="btn btn-ghost">See the portfolio</a>
      </div>
    </div>
  </section>

  <section class="screens">
    <div class="wrap">
      <h2 class="screens-title">A first look</h2>
      <p class="screens-sub">Browse a curated catalog, then check any product against your shelf before you buy.</p>
      <div class="screens-grid">
        <figure class="phone">
          <img src="/assets/layer-browse.webp" width="377" height="820" alt="Layer app — browse a catalog of skincare products by category, with brand and ingredient details." loading="lazy" decoding="async" />
          <figcaption>Browse by category</figcaption>
        </figure>
        <figure class="phone">
          <img src="/assets/layer-product.webp" width="377" height="820" alt="Layer app — a skincare product page showing step, key ingredients, targets, skin type, strength and finish." loading="lazy" decoding="async" />
          <figcaption>Know every ingredient</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="prose">
    <h2>What Layer is</h2>
    <p>Layer helps people make sense of their skincare. Catalog the products you own, build a step-by-step routine that respects correct layering order, log how your skin responds over time, and get a clear picture of what to keep, cut, or try next—then link out to buy the products you want.</p>

    <h2>For partners &amp; advertisers</h2>
    <p>Layer reaches an engaged audience of skincare buyers—people actively researching and purchasing cleansers, serums, moisturizers, SPF, and tools. For beauty and skincare brands interested in partnering or affiliate placement, reach the studio at <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>

    <h2>Launching soon</h2>
    <p>Layer is in active development. Check back for the launch, or <a href="/contact">contact us</a> to be notified when it goes live.</p>
  </div>

  <style>
    .screens {
      background: #F7F4EF;
      padding: 4rem 1.25rem 4.5rem;
      border-top: 1px solid rgba(0,0,0,0.06);
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }
    .screens .wrap { max-width: 920px; margin: 0 auto; text-align: center; }
    .screens-title {
      font-size: clamp(1.6rem, 3vw, 2.1rem);
      margin: 0 0 0.5rem;
      letter-spacing: 0.01em;
    }
    .screens-sub {
      max-width: 38rem;
      margin: 0 auto 2.75rem;
      color: #4a4a45;
      font-size: 1.05rem;
      line-height: 1.55;
    }
    .screens-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 2.5rem;
      justify-content: center;
      align-items: flex-start;
    }
    .phone { margin: 0; width: 232px; }
    .phone img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 30px;
      border: 1px solid rgba(0,0,0,0.08);
      box-shadow: 0 18px 50px -18px rgba(20,40,30,0.45);
      background: #F7F4EF;
    }
    .phone figcaption {
      margin-top: 1rem;
      font-size: 0.92rem;
      font-weight: 600;
      color: #1f5f4a;
      letter-spacing: 0.01em;
    }
    @media (max-width: 520px) {
      .phone { width: 70%; max-width: 260px; }
      .screens-grid { gap: 2.75rem; }
    }
  </style>
</BaseLayout>
