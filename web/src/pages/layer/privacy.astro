---
// App-level Privacy Policy for the Layer iOS app. This is the URL submitted to
// App Store Connect. It MIRRORS app/legal/privacy.tsx in the Layer repo —
// keep the two in sync whenever data handling changes (new SDK, new backend).
// Distinct from /privacy, which covers this corporate site only.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../../consts';

const effective = '2026-08-02';
---
<BaseLayout
  title="Layer App Privacy Policy"
  description="Privacy Policy for Layer: Skincare Advisor, the iOS app by Timberline Ventures LLC."
  path="/layer/privacy"
>
  <slot name="head" slot="head">
    <BreadcrumbSchema crumbs={[
      { name: 'Layer', path: '/layer' },
      { name: 'Privacy Policy', path: '/layer/privacy' },
    ]} />
  </slot>

  <div class="page-hero">
    <div class="wrap">
      <h1>Layer Privacy Policy</h1>
      <p>How the Layer: Skincare Advisor iOS app handles your skin profile, your shelf, and your device data.</p>
    </div>
  </div>

  <div class="prose">
    <p class="effective">Last updated: {effective}</p>

    <h2>What Layer stores</h2>
    <p>
      Your skin profile (skin type, concerns, age range, sensitivity, any conditions you tell us about) and your shelf of products live on your device. Layer does not require an account, and we do not upload your profile or shelf to our servers.
    </p>

    <h2>What leaves your device</h2>
    <p>
      If you send feedback from the app, we receive the message you write along with basic diagnostics: app version, device platform and OS version, and whether you have an active subscription. If you include your email address, we get that too.
    </p>
    <p>
      Layer also uses crash reporting (Sentry) so we can fix bugs, and product analytics (PostHog) so we can see which features get used. These collect technical event data like screens visited, taps on buy links, app version, and device model. They do not receive your skin profile, your shelf, or your name. Analytics runs under a random identifier, not your identity.
    </p>

    <h2>Purchases</h2>
    <p>
      Subscriptions are processed by Apple. Layer uses RevenueCat to check your subscription status; RevenueCat receives an anonymous identifier, not your name or email. We never see your payment details.
    </p>

    <h2>Shopping links</h2>
    <p>
      When you tap a buy link, you leave Layer and go to the retailer&rsquo;s site through an affiliate network (such as Awin or CJ). The network sets its own cookies to credit the referral. Layer may earn a commission on purchases you make there. What you browse or buy on the retailer&rsquo;s site is governed by their privacy policy, not ours.
    </p>

    <h2>Health information</h2>
    <p>
      Details you enter about your skin, including sensitivity and skin conditions, are health-related information. They stay on your device and are used only to shape what the app shows you. Deleting the app deletes them.
    </p>

    <h2>Children</h2>
    <p>
      Layer is not directed to children under 13, and we do not knowingly collect personal information from them.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about this policy? Use the feedback option in the app&rsquo;s Profile tab, or email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>. Layer is made by Timberline Ventures LLC.
    </p>

    <p>See also the <a href="/layer/terms">Layer Terms of Use</a>.</p>
  </div>
</BaseLayout>
