---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonSchema from '../components/schema/PersonSchema.astro';
import AboutPageSchema from '../components/schema/AboutPageSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE, PORTFOLIO, PORTFOLIO_GROUPS } from '../consts';

const grouped = PORTFOLIO_GROUPS.map((g) => ({
  label: g,
  brands: PORTFOLIO.filter((b) => b.group === g),
}));
---
<BaseLayout
  title="About"
  description={`About Timberline Ventures LLC, an independent studio founded by ${SITE.founder.name}. We build iOS apps that learn your taste, plus bilingual financial guides for ITIN holders.`}
  path="/about"
>
  <slot name="head" slot="head">
    <PersonSchema />
    <AboutPageSchema />
    <BreadcrumbSchema crumbs={[{ name: 'About', path: '/about' }]} />
  </slot>

  <div class="page-hero">
    <div class="wrap">
      <h1>About Timberline Ventures</h1>
      <p>An independent studio building iOS apps that learn your taste, and honest financial guides for people the big sites skip over.</p>
    </div>
  </div>

  <div class="prose">
    <h2>What we do</h2>
    <p>
      Timberline Ventures LLC is a bootstrapped studio. We design and run a small set of products: native iOS apps for people who collect and care about things, and bilingual financial guides for ITIN holders. We go after niches where good software and honest information are both hard to find.
    </p>
    <p>
      Every product we run is built for a specific audience and looked after with real care. When we make money, we do it in ways that line up with what the people using our products actually want, never at their expense.
    </p>

    <h2>One engine, many apps</h2>
    <p>
      What ties the apps together is a single taste engine. It learns what you like from how you use an app: the bottles you keep, the roasts you rate again. It looks for the pattern behind your choices, and each suggestion gets a step closer than the last.
    </p>
    <p>
      Each app keeps what it learns to itself. Pour Picks&#39; read on your whiskey never leaves Pour Picks, and deleting one app tells the others nothing. Building them under one roof buys us the engine itself: every new app starts from machinery we have already spent years tuning, and the same standards for how your data gets treated.
    </p>

    <h2>The studio</h2>
    <p>
      <strong>{SITE.founder.name}</strong> started Timberline Ventures in {SITE.foundedYear}. We keep it small on purpose. We ship when things are ready and take the long view on both product quality and search. No investors, no shortcuts.
    </p>
    <p>
      We are based in the United States and work fully remotely.
    </p>

    <h2>Our portfolio</h2>

    {grouped.map((group) => (
      <div style="margin-bottom: 32px;">
        <h3>{group.label}</h3>
        <ul>
          {group.brands.map((brand) => (
            <li>
              <strong><a href={brand.url} {...(brand.internal ? {} : { target: '_blank', rel: 'noopener' })}>{brand.name}</a></strong>
              {': '}{brand.blurb}
            </li>
          ))}
        </ul>
      </div>
    ))}

    <h2>Editorial independence</h2>
    <p>
      The ITIN sites are <strong>independent publishers</strong>. We are not a lender, a mortgage broker, a financial advisor, or a credit repair company. When we point to a third-party product, we say so and disclose the affiliate relationship right on the page. Our editorial calls are not for sale.
    </p>

    <h2>Contact</h2>
    <p>
      For business, partnerships, or press, email us at <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>. The studio is also on <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>.
    </p>
  </div>
</BaseLayout>
