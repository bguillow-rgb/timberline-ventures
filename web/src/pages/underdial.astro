---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';
---
<BaseLayout
  title="Under Dial — Affordable Premium Watches"
  description="Under Dial is an upcoming iOS app for watch lovers shopping under $1,000—discover watches that fit your wrist and your taste, check value before you buy, and build a collection that makes sense. A Timberline Ventures product, coming soon."
  path="/underdial"
>
  <slot name="head" slot="head">
    <BreadcrumbSchema crumbs={[{ name: 'Under Dial', path: '/underdial' }]} />
  </slot>

  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Coming Soon · Consumer Apps</span>
      <h1>Under Dial — <em>premium watches</em>, under $1,000</h1>
      <p class="hero-sub">
        A native iOS app for people who love watches but do not want to overspend. Discover pieces that suit your wrist and your style, run a WatchFit check before you buy, and grow a collection without the redundant fifth black-dial diver. Built and operated by Timberline Ventures LLC.
      </p>
      <div class="cta-row">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href="/#portfolio" class="btn btn-ghost">See the portfolio</a>
      </div>
    </div>
  </section>

  <div class="prose">
    <h2>What Under Dial is</h2>
    <p>Under Dial is a discovery and buying advisor for watches under $1,000. Tell it what you already own and how you actually wear a watch, and it points you to pieces worth your money: the right case size for your wrist, a movement you can trust, and an honest nudge when there is a cheaper watch with the same specs. No hype, no $10k grail bait—just smart picks in a range real people buy.</p>

    <h2>For partners &amp; advertisers</h2>
    <p>Under Dial reaches an engaged audience of watch buyers—people researching and purchasing microbrand and accessible-luxury watches, straps, and tools. For watch brands and retailers interested in partnering or affiliate placement, reach the studio at <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>

    <h2>Launching soon</h2>
    <p>Under Dial is in active development. Check back for the launch, or <a href="/contact">contact us</a> to be notified when it goes live.</p>
  </div>
</BaseLayout>
