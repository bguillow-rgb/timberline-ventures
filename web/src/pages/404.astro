---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---
<BaseLayout
  title="Page Not Found"
  description="The page you requested could not be found."
  path="/404"
  noindex={true}
>
  <div class="page-hero" style="padding: 120px 0 100px; text-align: center;">
    <div class="wrap">
      <p style="font-size: 80px; margin: 0 0 16px; color: var(--accent); font-family: var(--serif); font-weight: 700; line-height: 1;">404</p>
      <h1 style="font-size: 32px; margin: 0 0 16px;">Page not found</h1>
      <p style="max-width: 420px; margin: 0 auto 32px;">The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="btn btn-primary">Back to home</a>
    </div>
  </div>
</BaseLayout>
