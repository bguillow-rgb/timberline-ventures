---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQPageSchema from '../components/schema/FAQPageSchema.astro';
import { SITE, PORTFOLIO, PORTFOLIO_GROUPS } from '../consts';

const faqs = [
  { q: 'What is Timberline Ventures LLC?', a: 'Timberline Ventures LLC is an independent digital product studio. We build a family of consumer iOS apps that learn what you like, and we publish three bilingual financial guidance sites for ITIN holders in the U.S.' },
  { q: 'What do you mean by a taste engine?', a: 'Every Timberline app runs on the same engine, one that learns your taste from how you use it: which bottles you keep, which watches you save. It works out the pattern behind your choices instead of handing you a list, and each app keeps what it learns to itself.' },
  { q: 'What apps does Timberline Ventures publish?', a: 'Three are on the App Store today: Pour Picks for bourbon and whiskey, Perfume Picks for fragrance, and Percolate for specialty coffee. Stick Picks for cigars and Underdial for watches are close behind, and four more are in the works: Cabin for private jet charter, Layer for skincare, Right of Way for new drivers, and Game Night for board games. All are native iOS apps.' },
  { q: 'Who operates the ITIN information sites?', a: 'itinlending.net, itincreditcard.com, and itincreditscore.com are owned and operated by Timberline Ventures LLC. They publish independent, bilingual guides for ITIN holders. Timberline is not a lender or a broker.' },
  { q: 'Is Timberline Ventures a lender or financial advisor?', a: 'No. The ITIN sites are independent publishers, not lenders, brokers, or financial advisors. Everything on them is for information only.' },
  { q: 'How can I reach you?', a: `Email the studio at ${SITE.contactEmail}. For help with a specific app, use the support link inside that app.` },
];

const groups = {
  apps: PORTFOLIO.filter((b) => b.group === 'Consumer apps'),
  finance: PORTFOLIO.filter((b) => b.group === 'Financial information'),
};
---
<BaseLayout
  title={SITE.shortName}
  description={SITE.description}
  path=""
>
  <slot name="head" slot="head">
    <FAQPageSchema faqs={faqs} />
  </slot>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <h1 class="hero-wordmark">Timberline Ventures</h1>
      <p class="hero-tagline"><span class="hero-dash" aria-hidden="true"></span><em>Apps that learn what you like.</em></p>
      <p class="hero-kicker">One taste engine &nbsp;&middot;&nbsp; A family of iOS apps</p>
      <div class="cta-row">
        <a href="/#portfolio" class="btn btn-primary">See the apps</a>
        <a href="/#dna" class="btn btn-ghost">How they learn you</a>
      </div>
    </div>
  </section>

  <!-- STAT STRIP -->
  <div class="stats">
    <div class="wrap">
      <div class="stat">
        <div class="num">3</div>
        <div class="label">Apps live, with more coming</div>
      </div>
      <div class="stat">
        <div class="num">9</div>
        <div class="label">Apps in the family, one engine</div>
      </div>
      <div class="stat">
        <div class="num">EN&nbsp;+&nbsp;ES</div>
        <div class="label">Financial guides in two languages</div>
      </div>
    </div>
  </div>

  <!-- DNA / TASTE ENGINE -->
  <section id="dna" class="dna">
    <div class="wrap">
      <div class="dna-copy">
        <p class="kicker">The engine underneath</p>
        <h2>Built to <em>learn you</em></h2>
        <p class="lede">
          Most apps hand you a list and hope something sticks. Ours watch what you actually keep and reach for, then work out the pattern behind it.
        </p>
        <p>
          The bottles you cellar, the watches you save, the roasts you rate again. Each choice teaches the engine a little more about your taste, so the next suggestion lands closer than the last. After a while it feels less like a catalog and more like a friend who already knows what you go for.
        </p>
        <p class="dna-note">
          Each app keeps its own read on you. What Pour Picks learns about your whiskey stays in Pour Picks; the coffee app starts from zero and earns its own picture. Your taste data stays inside the app you gave it to.
        </p>
      </div>
      <div class="dna-diagram">
        <img
          class="dna-graph"
          src="/assets/hub-spoke.svg"
          alt="Hub and spoke diagram: at the center, the people we build for; around them, each Timberline app and site as its own spoke, with the shared engine, app factory, growth, and reporting layer in between."
          width="1280"
          height="1010"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- CONSUMER APPS -->
  <section id="portfolio">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">The apps</p>
        <h2>What&#39;s live and what&#39;s coming</h2>
        <p>Each app is built for people who care about one thing and want to go deep on it. Same engine, different shelf. The ones marked coming soon are on the bench right now.</p>
      </div>
      <div class="card-grid">
        {groups.apps.map((brand) => (
          <a
            class="card"
            href={brand.url}
            {...(brand.internal ? {} : { target: '_blank', rel: 'noopener' })}
          >
            {brand.icon
              ? <img class="app-icon" src={brand.icon} alt={`${brand.name} app icon`} width="56" height="56" loading="lazy" />
              : <span class="badge">{brand.initials}</span>}
            <h3>{brand.name}</h3>
            <p>{brand.blurb}</p>
            <span class="visit">{brand.cta ?? 'Visit site'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FINANCIAL INFORMATION -->
  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Financial information</p>
        <h2>Honest guides for ITIN holders</h2>
        <p>Three bilingual sites that answer the money questions ITIN holders actually ask, in clear English and Spanish. We are not a lender or a broker, just a publisher trying to get it right.</p>
      </div>
      <div class="card-grid">
        {groups.finance.map((brand) => (
          <a class="card" href={brand.url} target="_blank" rel="noopener">
            <span class="badge">{brand.initials}</span>
            <h3>{brand.name}</h3>
            <p>{brand.blurb}</p>
            <span class="visit">{brand.cta ?? 'Visit site'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- VALUES / APPROACH -->
  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">How we work</p>
        <h2>Small studio, long memory</h2>
        <p>We pick niches we can serve well and stay in them for years. That patience is what lets the taste engine get good.</p>
      </div>
      <div class="value-grid">
        <div class="value">
          <h3><span class="ico">&#9650;</span>We build fewer things</h3>
          <p>We ship fewer features and fewer pages than we could, and we sweat the ones we keep. Depth is what earns a spot on someone's home screen, and it is what search rewards too.</p>
        </div>
        <div class="value">
          <h3><span class="ico">&#9670;</span>Trust comes first</h3>
          <p>Our finance sites deal with people's money, so accuracy is not optional. Real sources and clear disclosure, in both languages from day one. The apps follow the same rule: your taste data is yours.</p>
        </div>
        <div class="value">
          <h3><span class="ico">&#9679;</span>No investors, no agenda</h3>
          <p>We are bootstrapped. Nobody is pushing us to chase a metric that does not serve the people using our stuff, so we can say things plainly and build for the long haul.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="wrap">
      <h2>Want to talk?</h2>
      <p>Partnership, licensing, a content collaboration, or just a question. Reach the studio directly.</p>
      <a href="/contact" class="btn btn-primary">Get in touch</a>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">FAQ</p>
        <h2>Common questions</h2>
      </div>
      <div style="max-width:740px;margin:0 auto;">
        {faqs.map((f) => (
          <div class="faq-item">
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
