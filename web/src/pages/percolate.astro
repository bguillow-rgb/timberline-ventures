---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';
---
<BaseLayout
  title="Percolate — Coffee Discovery App"
  description="Percolate is an upcoming iOS app for coffee lovers—discover roasters and beans, dial in your brew, and track every cup. A Timberline Ventures product, coming soon."
  path="/percolate"
>
  <slot name="head" slot="head">
    <BreadcrumbSchema crumbs={[{ name: 'Percolate', path: '/percolate' }]} />
  </slot>

  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Coming Soon · Consumer Apps</span>
      <h1>Percolate — your <em>coffee</em> companion</h1>
      <p class="hero-sub">
        A native iOS app for coffee lovers: discover roasters and single-origin beans, dial in your brew, log every cup, and find the next bag worth buying. Built and operated by Timberline Ventures LLC.
      </p>
      <div class="cta-row">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href="/#portfolio" class="btn btn-ghost">See the portfolio</a>
      </div>
    </div>
  </section>

  <div class="prose">
    <h2>What Percolate is</h2>
    <p>Percolate helps everyday coffee drinkers and home enthusiasts get more from every cup. Browse and save roasters and beans, record brew recipes and tasting notes, and build a personal log of what you have tried and what to reach for next—then link out to buy the beans and gear you love.</p>

    <h2>For partners &amp; advertisers</h2>
    <p>Percolate reaches an engaged audience of coffee buyers—people actively choosing beans, brewing equipment, subscriptions, and accessories. For coffee roasters, equipment brands, and subscription services interested in partnering or affiliate placement, reach the studio at <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>

    <h2>Launching soon</h2>
    <p>Percolate is in active development. Check back for the launch, or <a href="/contact">contact us</a> to be notified when it goes live.</p>
  </div>
</BaseLayout>
