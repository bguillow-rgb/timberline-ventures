---
import { SITE } from '../../consts';

// AboutPage schema completes the entity-anchor trio (Organization + Person +
// AboutPage) on /about.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About \u2014 ${SITE.shortName}`,
  url: `${SITE.url}/about`,
  inLanguage: SITE.locale,
  mainEntity: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
