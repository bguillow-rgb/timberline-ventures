# Timberline Ventures — environment variables
# Copy to .env and fill in values. All are optional; omitting them disables
# the corresponding feature (analytics, GSC verification, IndexNow).
# These are baked into the static HTML at build time.

# Google Analytics 4 Measurement ID — e.g. G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification value
PUBLIC_GSC_VERIFICATION=

# IndexNow key (also requires serving /{{key}}.txt at site root)
PUBLIC_INDEXNOW_KEY=
